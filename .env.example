DISCORD_TOKEN=replace-me
DISCORD_OWNER_ID=replace-with-your-user-id
DATABASE_URL=sqlite+aiosqlite:///./nova.db
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# Optional: sync commands immediately to your private development server.
# Leave empty to register global commands (including supported DM contexts).
DISCORD_GUILD_ID=
# Phase 5: optional. CRUD and reminders work when AI is disabled.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# UTC daily limits; unknown API usage retains the conservative reservation.
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_REQUEST_LIMIT=100

# Optional connection credentials; configure approved resources in Settings.
# GitHub: selected repositories, Metadata/Issues/Pull requests/Contents read only.
# Notion reader is not installed yet. Never paste either token into Discord/chat.
GITHUB_READ_TOKEN=
NOTION_READ_TOKEN=
